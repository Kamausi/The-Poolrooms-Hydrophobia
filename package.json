{
  "name": "underflow",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "First-person horror rail-shooter in the Poolrooms, rendered with 67js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run && node tests/run.mjs",
    "test:maps": "node tests/maps.mjs",
    "test:balance": "node tests/run.mjs balance",
    "build:single": "node scripts/single-html.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "vitest run",
    "test:e2e": "node tests/run.mjs"
  },
  "dependencies": {
    "67js": "npm:@codepawlhq/67js@0.16.0"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "^6.0.0",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
